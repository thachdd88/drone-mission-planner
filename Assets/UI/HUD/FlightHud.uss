/* Flight HUD styles. Sizes are in reference pixels (1920x1080, see HudPanelSettings). */

.hud-root {
    flex-grow: 1;
    justify-content: space-between;
    padding: 24px;
}

.hud-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hud-row--bottom {
    align-items: flex-end;
}

.hud-center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hud-panel {
    min-width: 240px;
    padding: 12px 16px;
    background-color: rgba(10, 14, 20, 0.75);
    border-width: 1px;
    border-color: rgba(120, 200, 255, 0.35);
    border-radius: 6px;
}

.hud-panel--center {
    min-width: 180px;
    align-items: center;
}

.hud-panel--right {
    align-items: flex-end;
}

.hud-title {
    font-size: 16px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    letter-spacing: 2px;
    color: rgb(120, 200, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding: 0;
}

.hud-value {
    font-size: 22px;
    color: rgb(235, 242, 248);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 1px 0;
}

.hud-value--big {
    font-size: 34px;
    -unity-font-style: bold;
}

.batt-row {
    flex-direction: row;
    align-items: flex-end;
}

.batt-row > .hud-value {
    margin-left: 12px;
}

.batt-bar {
    width: 208px;
    height: 10px;
    margin: 6px 0;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
}

.batt-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(80, 210, 120);
}

.batt-fill--low {
    background-color: rgb(245, 185, 50);
}

.batt-fill--critical {
    background-color: rgb(235, 70, 60);
}

.hud-warning {
    display: none;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(200, 40, 30, 0.8);
    padding: 8px 24px;
    border-radius: 6px;
    letter-spacing: 3px;
}
